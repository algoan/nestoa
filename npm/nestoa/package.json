{
  "name": "nestoa",
  "version": "0.1.0",
  "description": "Static OpenAPI / AsyncAPI generator for NestJS / TypeScript codebases",
  "bin": {
    "nestoa": "bin/nestoa.js"
  },
  "files": [
    "bin",
    "install.js",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node install.js"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@nestoa/linux-x64-gnu": "0.1.0",
    "@nestoa/linux-arm64-gnu": "0.1.0",
    "@nestoa/linux-x64-musl": "0.1.0",
    "@nestoa/linux-arm64-musl": "0.1.0",
    "@nestoa/darwin-x64": "0.1.0",
    "@nestoa/darwin-arm64": "0.1.0",
    "@nestoa/win32-x64-msvc": "0.1.0"
  },
  "keywords": [
    "nestjs",
    "openapi",
    "swagger",
    "asyncapi",
    "typescript",
    "generator",
    "static-analysis"
  ],
  "license": "MIT"
}
