{
  "name": "nestoa",
  "version": "0.1.0",
  "description": "Static OpenAPI / AsyncAPI generator for NestJS / TypeScript codebases",
  "homepage": "https://github.com/algoan/nestoa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algoan/nestoa.git"
  },
  "bugs": "https://github.com/algoan/nestoa/issues",
  "bin": {
    "nestoa": "bin/nestoa.js"
  },
  "files": [
    "bin",
    "install.js",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node install.js"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@algoan/nestoa-linux-x64-gnu": "0.1.0",
    "@algoan/nestoa-linux-arm64-gnu": "0.1.0",
    "@algoan/nestoa-linux-x64-musl": "0.1.0",
    "@algoan/nestoa-linux-arm64-musl": "0.1.0",
    "@algoan/nestoa-darwin-x64": "0.1.0",
    "@algoan/nestoa-darwin-arm64": "0.1.0",
    "@algoan/nestoa-win32-x64-msvc": "0.1.0"
  },
  "keywords": [
    "nestjs",
    "openapi",
    "swagger",
    "asyncapi",
    "typescript",
    "generator",
    "static-analysis"
  ],
  "license": "MIT"
}
